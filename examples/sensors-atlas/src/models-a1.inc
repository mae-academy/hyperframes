};
// 5 liquid-level capacitor ---------------------------------------------------
const capLC = (h) => (2 * PI * K.eps0 * ((K.capL.er * h + (K.capL.L - h)) * 1e-3)) / Math.log(K.capL.D2 / K.capL.D1);
SENS.capL = {
