// ===== chapter 4: temperature =====
const K = D.k, PI = Math.PI, ST = COL.steel, SD = COL.steelD, GD = COL.gold, TL = COL.teal, OR = COL.orange, GR = COL.green, BL = COL.blue, PU = COL.purple, NV = COL.navy, GL = COL.glass;
const SENS = {};
const heat = (t) => mix(mix(SD, OR, clamp(t * 1.6)), "#FFE9B0", clamp((t - 0.55) * 2));
// atom lattice inside a glass cube; jitter amplitude grows with temperature
function lattice(c, n, amp, o = 1) { box(c, [2.6, 0.5, 2.6], GL, 0.2 * o); for (let i = 0; i < n; i++) for (let j = 0; j < n; j++) { const sx = (seeded(i * 7 + j * 13) - 0.5) * 2, sz = (seeded(i * 11 + j * 5 + 3) - 0.5) * 2; dot([c[0] + (i - (n - 1) / 2) * 0.62 + sx * amp, c[1] - 0.3, c[2] + (j - (n - 1) / 2) * 0.62 + sz * amp], 0.15, mix(NV, OR, clamp(amp * 2.5)), o); } }
// 27 RTD ------------------------------------------------------------------------------------------------
const rtdR = (T, q) => K.rtd.R0 * (1 + q * 1e-3 * T);
SENS.rtd = {
  view: { yaw: -0.4, pitch: 0.2, dist: 21, tx: 1.6, tz: 1.2 }, p: [0, 300, 300], q: [3.85, 6.18], x: [0, 600], y: [80, 480], ns: 20,
  out: (T, q) => rtdR(T, q), kb: [{ c: [0, 0, -1], s: [4, 4, 0.8], col: SD }, { c: [0, 0, 1.5], s: [2.2, 2.2, 5], col: GL }],
  build(T, q) {
    const f = clamp(T / 600); shadow([0, 0, -1], 4, 3); box([0, 0, -1.2], [5.2, 4, 0.5], SD); box([0, 0, -0.7], [3.6, 3, 0.5], heat(f));
    glassCyl("z", [0, 0, 2.0], 5, 1.25, 1); cyl("z", [0, 0, 2.0], 4.6, 0.55, COL.white);
    for (let i = 0; i < 12; i++) ring("z", [0, 0, 0.2 + i * 0.28], 0.62, mix(NV, COL.red, f), 4, 1);
    cyl("z", [0, 0, 5.0], 1.0, 0.7, SD); ln([[0, 0, 5.4], [0, 0, 6.0], [4.8, 0, 6.0], [4.8, 0, 3.4]], NV, 4);
    ln([[1.3, 0, 1.2], [3.2, 0, 1.4]], NV, 3, 0.4, "10 8"); ln([[1.3, 0, 3.0], [3.2, 0, 2.7]], NV, 3, 0.4, "10 8");
    lattice([5.6, 0, 2.0], 4, 0.12 * f * (q / 3.85 > 1 ? 1.2 : 1), 1);
    arw([-3.2, -1.9, -0.9], [-3.2, -1.9, -0.9 + 1.2 + 2 * f], OR, 8);
    outBar(8.4, (rtdR(T, q) - 80) / 400, 1, -0.9, 3.4);
  },
  lab: [["T", (T) => [-3.2, -1.9, 1.2 + 2 * clamp(T / 600)]], ["Rt", (T, q) => [8.4, 0, -0.9 + 3.4 * ((rtdR(T, q) - 80) / 400) + 0.7]]],
};
// 28 NTC thermistor ---------------------------------------------------------------------------------------------
const thmR = (T) => K.thm.R0 * Math.exp(K.thm.beta * (1 / (T + 273.15) - 1 / (K.thm.T0 + 273.15)));
SENS.thm = {
  view: { yaw: -0.4, pitch: 0.2, dist: 20, tx: 1.8, tz: 1.0 }, p: [0, 80, 100], x: [0, 100], y: [0, 35], ns: 90,
  out: thmR, ideal: (T) => lerp(thmR(0), thmR(100), T / 100),
  kb: [{ c: [0, 0, -0.9], s: [4, 4, 0.8], col: SD }, { c: [0, 0, 1.0], s: [2, 2, 2], col: GD }],
  build(T) {
    const f = clamp(T / 100); shadow([0, 0, -1], 4, 3); box([0, 0, -1.2], [5.2, 4, 0.5], SD); box([0, 0, -0.7], [3.6, 3, 0.5], heat(f * 0.8));
    sph([0, 0, 0.6], 1.0, mix(NV, GD, 0.55 + 0.3 * f), 1, 8, 14); ln([[-0.3, 0, -0.3], [-1.0, 0, -0.8], [-1.0, 0, -0.5]], NV, 5); ln([[0.3, 0, -0.3], [1.0, 0, -0.8]], NV, 5);
    ln([[0, 0, 1.6], [0, 0, 3.4], [4.2, 0, 3.4], [4.2, 0, 3.0]], NV, 4, 0.0);
    box([4.8, 0, 1.4], [3.0, 0.6, 3.0], GL, 0.25);
    const nC = Math.round(2 + 26 * clamp(thmR(25) / Math.max(0.5, thmR(T)) / 20 * 1.0 + f * 0.4));
    for (let i = 0; i < 8; i++) for (let j = 0; j < 8; j++) if (i % 2 === j % 2) dot([4.8 + (i - 3.5) * 0.3, -0.35, 1.4 + (j - 3.5) * 0.3], 0.06, mix(NV, GL, 0.4), 0.9);
    for (let i = 0; i < nC; i++) { const x = 4.8 + (seeded(i + 3) - 0.5) * 2.4, z = 1.4 + (seeded(i + 40) - 0.5) * 2.4; dot([x, -0.55, z], 0.12, OR); dot([x + 0.22, -0.55, z - 0.18], 0.12, TL); }
    arw([-3.2, -1.9, -0.9], [-3.2, -1.9, -0.9 + 1.2 + 2 * f], OR, 8);
    outBar(9.2, thmR(T) / 35, 1, -0.9, 3.4);
  },
  lab: [["T", (T) => [-3.2, -1.9, 1.2 + 2 * clamp(T / 100)]], ["Rth", (T) => [9.2, 0, -0.9 + 3.4 * (thmR(T) / 35) + 0.7]]],
};
// 29 thermocouple (Seebeck / Peltier) -------------------------------------------------------------------------------------
const CHR = SD, CON = mix(OR, GD, 0.45);
SENS.tc = {
  view: { yaw: -0.4, pitch: 0.2, dist: 22, tx: 1.8, tz: 0.8 }, p: [0, 300, 300], q: [0, 1], x: [0, 400], y: [0, 17], ns: 20,
  out: (T) => K.tc.aS * T, kb: [{ c: [-4, 0, -0.3], s: [3, 3, 1.4], col: SD }, { c: [3, 0, -0.3], s: [2, 2, 1.4], col: GL }],
  build(T, q) {
    const f = clamp(T / 400); shadow([0, 0, -1], 9, 3); box([0, 0, -1.3], [17, 3.4, 0.3], SD);
    box([-4.6, 0, -0.6], [3.2, 3, 1.4], heat(f * 0.9)); box([3.0, 0, -0.6], [2.4, 3, 1.4], mix(GL, mix(TL, OR, q), 0.6));
    const hot = [-4.2, 0, 0.5], cold = [3.0, 0, 0.5], jc = mix(heat(f), TL, q);
    ln([[hot[0], -0.45, 0.5], [cold[0], -0.45, 0.5], [7.0, -0.45, 0.5], [7.0, -0.45, 1.6]], CHR, 7, 1); ln([[hot[0], 0.45, 0.5], [cold[0], 0.45, 0.5], [7.0, 0.45, 0.5], [7.0, 0.45, 1.6]], CON, 7, 1);
    sph([hot[0], 0, 0.5], 0.42, jc, 1, 6, 10); dot([cold[0], -0.45, 0.5], 0.15, NV); dot([cold[0], 0.45, 0.5], 0.15, NV);
    const n = Math.round(3 + 12 * f); for (let i = 0; i < n; i++) { const x = hot[0] + 0.6 + ((cold[0] - hot[0] - 0.9) * (i + 0.5)) / n; dot([x, -0.45, 0.62], 0.1, TL, 1 - q * 0.6); dot([x, 0.45, 0.62], 0.1, TL, 1 - q * 0.6); }
    if (q > 0.02) { ln([[hot[0], 0, 0.5], [hot[0], 0, 3.0], [7.0, 0, 3.0], [7.0, 0, 1.7]], NV, 5, q, "14 10", 0.4); arw([-1, 0, 3.0], [1.2, 0, 3.0], NV, 8, q); }
    box([7.0, 0, 2.3], [2.2, 1.6, 1.4], SD); box([7.0, -0.82, 2.3], [1.7, 0.05, 1.0], COL.white); const th = (clamp((K.tc.aS * T) / 17) * 2 - 1) * 0.9; ln([[7.0, -0.88, 1.9], [7.0 + Math.sin(th) * 0.8, -0.88, 1.9 + Math.cos(th) * 0.8]], GR, 5, 1);
    arw([-4.2, -1.9, -0.9], [-4.2, -1.9, -0.9 + 1.2 + 2 * f], OR, 8);
    outBar(10.6, (K.tc.aS * T) / 17, 1, -0.9, 3.4);
  },
  lab: [["Tj", () => [-4.2, -1.9, 3.0]], ["Tr", () => [3.0, -1.9, 1.6]], ["e", (T) => [10.6, 0, -0.9 + 3.4 * ((K.tc.aS * T) / 17) + 0.7]]],
};
// 30 radiative pyrometer ------------------------------------------------------------------------------------------------------
const radW = (T) => (K.rad.sigma * Math.pow(T + 273.15, 4)) / 1000;
SENS.rad = {
  view: { yaw: -0.38, pitch: 0.24, dist: 23, tx: 0.6, tz: 1.4 }, p: [200, 800, 1000], x: [200, 1000], y: [0, 160], ns: 90,
  out: radW, ideal: (T) => lerp(radW(200), radW(1000), (T - 200) / 800),
  kb: [{ c: [-6, 0, 0], s: [2.4, 2.4, 2.4], col: OR }, { c: [2.5, 0, 3.6], s: [1.6, 1.6, 1.0], col: GD }],
  build(T) {
    const f = clamp((T - 200) / 800), w = radW(T) / 160; shadow([0, 0, -1], 9, 2.6); box([0, 0, -1.3], [17, 3.0, 0.3], SD);
    box([-6, 0, -0.1], [2.4, 2.4, 2.4], heat(0.35 + 0.65 * f)); sph([-6, 0, 2.0], 0.0001, OR, 0);
    for (const dz of [-0.8, 0, 0.8]) ln([[-4.6, 0, 1.1 + dz * 0.5], [-0.3, 0, 1.1 + dz * 0.2]], OR, 5, 0.25 + 0.75 * w, "14 12", -w * 0.4);
    cyl("x", [0, 0, 1.1], 0.55, 1.6, GL, 0.6, { n: 24 }); ring("x", [0.3, 0, 1.1], 1.62, NV, 4, 0.8); ring("x", [-0.3, 0, 1.1], 1.62, NV, 4, 0.8);
    box([-1.3, 0, -0.3], [0.4, 0.4, 0.9], SD); box([0, 0, -0.3], [0.4, 0.4, 0.9], SD);
    box([2.6, 0, 1.1], [2.2, 0.3, 2.0], ST, 1, ["y", PI / 4 * 0 + 0.0]); box([2.6, 0, 1.1], [0.3, 2.0, 2.0], ST, 0);
    for (const dz of [-0.8, 0, 0.8]) ln([[0.3, 0, 1.1 + dz * 0.2], [2.6, 0, 1.1 + dz * 0.1], [2.6, 0, 3.2]], OR, 5, 0.25 + 0.75 * w, "14 12", -w * 0.4);
    box([2.6, 0, 3.7], [1.8, 1.8, 0.9], GD); for (let i = 0; i < 4; i++) box([2.6 - 0.6 + i * 0.4, 0, 4.25], [0.2, 1.4, 0.25], mix(SD, OR, w));
    ln([[2.6, 0, 4.4], [2.6, 0, 5.0], [6.2, 0, 5.0], [6.2, 0, 3.3]], NV, 4);
    arw([-6, -1.9, -0.9], [-6, -1.9, -0.9 + 1.0 + 2.4 * f], OR, 8);
    outBar(8.4, w, 1, -0.9, 3.4);
  },
  lab: [["T", (T) => [-6, -1.9, 1.5 + 2.4 * clamp((T - 200) / 800)]], ["W", (T) => [8.4, 0, -0.9 + 3.4 * (radW(T) / 160) + 0.7]]],
};
